    "definitions": {
      "cover_pct": "TeamRankings Cover %, net of pushes.",
      "home_minus_away_cover_pct_points": "Home cover percentage minus away cover percentage, in percentage points.",
      "top_20_pct_arena_profile": "True for the six highest home-minus-away ATS differentials among 30 teams.",
      "top_15_pct_arena_profile": "True for the five highest home-minus-away ATS differentials among 30 teams.",
      "game_arena_matchup_differential": "For future game analysis: home team home.cover_pct minus visiting team away.cover_pct."
    },
    "empirical_thresholds": {
      "top_20_pct_cutoff_home_minus_away_pct_points": 6.8,
      "top_15_pct_cutoff_home_minus_away_pct_points": 7.9,
      "recommended_game_level_arena_advantage_cutoff_pct_points": 8.0,
      "note": "The team-profile percentile thresholds describe a team own home-vs-away split. The 8.0 point game-level cutoff is a provisional Schedule Loss rule comparing the home team home ATS% with the visitor road ATS%."
    }
  },
